{
  "name": "react-resume-template",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run compile && next build --webpack",
    "clean": "rm -rf build-tsc .next",
    "compile": "tsc --build --verbose",
    "dev": "npm run compile && next dev",
    "lint": "eslint './src/**/*.{js,jsx,ts,tsx}' --max-warnings=0",
    "format": "prettier --write 'src/**/*.{js,jsx,json,ts,tsx,css}' '*.{js,json,mjs}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,json,ts,tsx,css}' '*.{js,json,mjs}'",
    "check": "npm run compile && npm run lint && npm run format:check",
    "start": "next start"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "autoprefixer": "^10.6.1",
    "classnames": "^2.5.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.6",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-module-resolver": "^1.5.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "stylelint": "^16.10.0",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "autoprefixer": "10.6.1",
    "fast-uri": "3.1.6",
    "immutable": "5.1.9"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "immutable": "5.1.9",
    "minimatch@^3.0.0": "3.1.5"
  }
}
